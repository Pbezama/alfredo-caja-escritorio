{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "Páginas locales del escritorio (setup, sin conexión, reloj, actualizar): configuran el local y reintentan.",
  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-setup-validate",
    "allow-setup-save",
    "allow-shell-retry",
    "allow-shell-open-clock-settings",
    "allow-shell-state",
    "allow-shell-quit",
    "allow-support-start-remote",
    "allow-support-copy-diagnostics",
    "allow-update-install"
  ]
}
